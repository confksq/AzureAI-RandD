# Copy to .env and fill in. .env is git-ignored — never commit real keys.
#
# Prefer an IAM role or `aws configure` over static keys where you can:
# boto3 resolves credentials automatically from the standard chain, so these
# two variables are only needed when no profile or instance role is available.

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=us-east-1

# Optional overrides (defaults shown)
# Claude 3 Sonnet (anthropic.claude-3-sonnet-20240229-v1:0) was retired
# 2025-07-21 and now 404s — see README. This is the current equivalent.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
